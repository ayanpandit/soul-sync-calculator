// Prisma schema for SoulSyncCalculator data storage
// Save this as prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SoulSyncResult {
  id        Int      @id @default(autoincrement())
  date      DateTime
  time      String
  gender    String
  yourName  String
  theirName String
  result    String
}
